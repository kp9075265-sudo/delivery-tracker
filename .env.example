# Copy this file to .env.local and replace the value with your Neon connection string.
# Never commit a real database connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
AUTH_SECRET=generate-a-long-random-secret
# Set this privately to a unique password at least 16 characters long.
ADMIN_PASSWORD=
# SMS stays disabled until you review/apply migration 003, obtain customer consent,
# configure a Twilio sender for each destination country, and explicitly enable it.
SMS_NOTIFICATIONS_ENABLED=false
# Set true only while using a Twilio trial account; it sends Twilio's predefined template bodies.
TWILIO_TRIAL_MODE=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Must exactly match the HTTPS callback URL configured for the Twilio sender/service.
TWILIO_STATUS_CALLBACK_URL=
